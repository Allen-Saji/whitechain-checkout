{
  "openapi": "3.1.0",
  "info": {
    "title": "Checkout integration API",
    "version": "0.1.0",
    "description": "Whitechain Sepolia USDT checkout. Keep API keys server-side. Cookie-authenticated mutations also require an exact matching Origin header. Receipts and merchant responses use no-store. Amounts are decimal strings in six-decimal token base units. The SDK is packaged in the source repository; no npm release is claimed."
  },
  "servers": [
    {
      "url": "https://checkout.allensaji.dev"
    }
  ],
  "paths": {
    "/v1/config": {
      "get": {
        "summary": "Network, contracts and current relayer availability",
        "operationId": "get__v1_config",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict"
          },
          "503": {
            "description": "Processing paused or relay restriction"
          }
        }
      }
    },
    "/v1/checkouts": {
      "post": {
        "summary": "Create an idempotent checkout with immutable order details",
        "operationId": "post__v1_checkouts",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict"
          },
          "503": {
            "description": "Processing paused or relay restriction"
          }
        },
        "security": [
          {
            "merchantApiKey": []
          },
          {
            "merchantSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$",
                    "description": "USDT base units: 1000000 = 1 USDT"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 120,
                    "default": "Order"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 500,
                    "default": ""
                  },
                  "expiresIn": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 3600,
                    "default": 900
                  }
                },
                "required": ["orderId", "amount"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
