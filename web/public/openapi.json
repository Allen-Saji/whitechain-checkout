          "409": {
            "description": "State conflict"
          },
          "503": {
            "description": "Processing paused or relay restriction"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
