{
  "name": "whitechain-checkout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "compile": "node scripts/compile.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck:web && pnpm compile && pnpm test && pnpm build:web",
    "test:fork": "RUN_FORK_TESTS=1 node --test --test-concurrency=1 tests/*.test.mjs",
    "dev:web": "next dev web --hostname 127.0.0.1 --port 4210",
    "build:web": "next build web",
    "preview:web": "next start web --hostname 127.0.0.1 --port 4210",
    "demo": "node scripts/start-demo.mjs",
    "typecheck:web": "tsc --project web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "fastify": "5.12.8",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3",
    "prettier-plugin-solidity": "2.4.1",
    "solc": "0.8.28",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.8.1"
}
