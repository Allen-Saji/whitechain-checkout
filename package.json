{
  "name": "whitechain-checkout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "compile": "node scripts/compile.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm compile && pnpm test && pnpm build:web",
    "test:fork": "RUN_FORK_TESTS=1 node --test --test-concurrency=1 tests/*.test.mjs",
    "dev:web": "vite --config web/vite.config.mjs",
    "build:web": "vite build --config web/vite.config.mjs",
    "preview:web": "vite preview --config web/vite.config.mjs"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "fastify": "5.12.8",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3",
    "prettier-plugin-solidity": "2.4.1",
    "solc": "0.8.28",
    "vite": "8.3.6"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.8.1"
}
