FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.8.1 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY contracts ./contracts
COPY scripts/compile.mjs ./scripts/compile.mjs
RUN pnpm compile
RUN pnpm prune --prod

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 DB_PATH=/data/checkout.sqlite DEMO_WORKER=0
RUN apt-get update && apt-get install -y --no-install-recommends gosu && apt-get clean
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/artifacts ./artifacts
COPY package.json ./
COPY src ./src
COPY sdk ./sdk
COPY deployments/whitechain-sepolia/deployment.json ./deployments/whitechain-sepolia/deployment.json
COPY scripts/backend-entrypoint.sh ./scripts/backend-entrypoint.sh
COPY scripts/set-merchant-budget.mjs ./scripts/set-merchant-budget.mjs
EXPOSE 4200
ENTRYPOINT ["sh", "scripts/backend-entrypoint.sh"]
