# Use 1 only for the isolated Anvil fork on loopback port 8550.
LOCAL_FORK=1
PORT=4200
APP_ORIGIN=http://127.0.0.1:4210
CHECKOUT_BASE_URL=http://127.0.0.1:4210/checkout
# Optional overrides:
# DB_PATH=.local/fork.sqlite
# CONFIRMATIONS=1
# DEMO_WORKER=0 pauses submissions and worker cycles.
# DEMO_WORKER=0
# Opt in only for a merchant whose demo orders may be public:
# DEMO_MERCHANT_ID=your-demo-merchant
# MERCHANT_CONFIG=.local/merchant-fork.json
# BOOKING_DB=.local/bookings.sqlite
# DEMO_PRICE=100000
