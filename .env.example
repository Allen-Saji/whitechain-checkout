# Use 1 only for the isolated Anvil fork on loopback port 8550.
LOCAL_FORK=1
PORT=4200
APP_ORIGIN=http://127.0.0.1:4210
CHECKOUT_BASE_URL=http://127.0.0.1:4210/checkout
# Optional overrides:
# DB_PATH=.local/fork.sqlite
# CONFIRMATIONS=1
# DEMO_WORKER=0 pauses submissions and worker cycles.
# DEMO_WORKER=0
# Opt in only for a merchant whose demo orders may be public:
# DEMO_MERCHANT_ID=your-demo-merchant
# MERCHANT_CONFIG=.local/merchant-fork.json
# BOOKING_DB=.local/bookings.sqlite
# DEMO_PRICE=100000

# Next.js server-only proxy origins (set before building):
# CHECKOUT_API_ORIGIN=http://127.0.0.1:4200
# CHECKOUT_MERCHANT_ORIGIN=http://127.0.0.1:4301

# Self-service merchant setup and conservative deployment-wide gas caps:
# MERCHANT_REGISTRATION_ENABLED=1
# REGISTRATION_DAILY_GAS_BUDGET=10000000000000000
# GLOBAL_DAILY_GAS_BUDGET=50000000000000000
# Exact trusted HTTP origin for the local example only; omit in public hosting:
# WEBHOOK_LOOPBACK_ORIGIN=http://127.0.0.1:4301
# Hosted backend: set RELAY_PRIVATE_KEY in the platform secret store, never here.
# HOST=0.0.0.0
# DB_PATH=/data/checkout.sqlite

# Optional bounded relay rehearsal (token amounts in base units):
# RELAY_CHECKOUT_ID=approved-checkout-uuid
# RELAY_MAX_PAYMENT_AMOUNT=100000
# RELAY_MAX_REFUND_AMOUNT=50000
# Public workspace preview is separately opt-in from the example shop:
# CHECKOUT_PREVIEW_ENABLED=1
